{
  "name": "lume-area-scout",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Highlight a neighborhood on a map, get a Knock Score (0-100). Personal door-knocking lead tool.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "nodemon --watch server --exec \"node --env-file=.env\" server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file=.env server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lru-cache": "^10.2.2",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.6.0"
  }
}
